  .cases { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .case { background: var(--paper-2); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); align-items: center; }
  .case:nth-child(even) { grid-template-columns: minmax(0, 1fr) minmax(0, 1.65fr); }
  .case:nth-child(even) .clip { order: 2; }
  .case .clip { border-bottom: 0; }
  .clip { position: relative; border-bottom: 1px solid var(--line); background: var(--paper); }
  .clip video { width: 100%; height: auto; aspect-ratio: 1840 / 1000; display: block; cursor: pointer; object-fit: cover; }
  .watch { position: absolute; right: 12px; bottom: 12px; font: inherit; font-size: 13px; font-weight: 500; padding: 6px 12px; border: 0; border-radius: 999px; background: var(--ink); color: var(--paper); cursor: pointer; }
  .watch:hover { background: #000; }
  .watch:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .badge { position: absolute; left: 12px; top: 12px; font-size: 12px; padding: 3px 9px; border-radius: 999px; background: rgba(251,250,246,0.92); color: var(--ink-2); pointer-events: none; }
  .case-body { padding: 32px 36px; display: flex; flex-direction: column; gap: 14px; }
  .case h3 { font-size: 22px; }
  .goal { font-size: 15px; color: var(--ink-3); }
  .case-body p:last-child { font-size: 15px; color: var(--ink-2); }

  .dark { background: var(--ink); color: var(--paper); }
  .dark a { color: var(--paper); }
  .dark .sub, .dim { color: #C9C6BE; }
  .dark .section { gap: 56px; }
  .stats { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 40px; }
  .stat { display: flex; flex-direction: column; gap: 8px; }
  .big { font-size: 56px; font-weight: 500; letter-spacing: -0.02em; }
  .stat .dim { font-size: 15px; }
  .notes { border-top: 1px solid rgba(244,241,234,0.2); padding-top: 32px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; }
  .notes ul { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; }
  .under { border-bottom: 1px solid rgba(244,241,234,0.5); }
  .under-dark { border-bottom: 1px solid var(--accent); }


  .faqsec { gap: 28px; }
  .faqlist { display: flex; flex-direction: column; border-top: 1px solid var(--line); max-width: 820px; }
  .faqlist details { border-bottom: 1px solid var(--line); padding: 18px 0; }
  .faqlist summary { cursor: pointer; font-weight: 500; font-size: 18px; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faqlist summary::-webkit-details-marker { display: none; }
  .faqlist summary::after { content: '+'; color: var(--accent); font-weight: 400; }
  .faqlist details[open] summary::after { content: '−'; }
  .faqlist summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 4px; }
  .faqlist p { margin-top: 10px; color: var(--ink-2); max-width: 68ch; }
  .more { border-bottom: 1px solid var(--accent); align-self: flex-start; }

  .cta { padding-top: 112px; padding-bottom: 112px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; }
  .mascot { width: 120px; height: auto; }
  .cta-title { font-size: 44px; letter-spacing: -0.02em; }

  .foot { padding-top: 48px; padding-bottom: 64px; display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; font-size: 14px; color: var(--ink-3); }
  .licence { max-width: 420px; }
  .fine { font-size: 12px; }
  .licence img { height: 24px; width: auto; }
  .fnav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 40px; }

  @media (max-width: 960px) {
    .case, .case:nth-child(even) { grid-template-columns: minmax(0, 1fr); }
    .case:nth-child(even) .clip { order: 0; }
    .hero { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .wrap { padding-left: 16px; padding-right: 16px; }
    .section { padding-top: 64px; padding-bottom: 64px; gap: 32px; }
    .nav { gap: 14px 18px; font-size: 14px; }
    .hero { padding-top: 32px; padding-bottom: 64px; gap: 40px; grid-template-columns: minmax(0, 1fr); }
    h1 { font-size: 40px; }
    :global(html[lang='zh-CN']) h1 { font-size: 30px; }
    h2 { font-size: 28px; }
    .cards3, .cases, .stats, .notes { grid-template-columns: minmax(0, 1fr); }
    .card, .case-body { padding: 24px; }
    .loop { padding: 24px; flex-basis: 100%; }
    .chain { flex-direction: column; }
    .link { width: 1.5px; height: 24px; flex-basis: 24px; margin: 0 0 0 27px; }
    .bench { flex-basis: 100%; padding: 24px; }
    .big { font-size: 44px; }
    .cta { padding-top: 72px; padding-bottom: 72px; }
    .cta-title { font-size: 34px; }
    .fnav { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 24px; }
    .play { left: 12px; bottom: 12px; }
  }
