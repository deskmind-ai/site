---
// The homepage, shared by / (English) and /zh/ (简体中文). Copy lives in src/i18n/home.ts.
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/jetbrains-mono/400.css';
import { APP_DOWNLOAD, APP_RELEASES, type HomeCopy } from '../i18n/home';

interface Props { t: HomeCopy }
const { t } = Astro.props;
const GH = 'https://github.com/deskmind-ai';
const HUB = `${GH}/deskmind`; // the one repo every "GitHub" link points at, so stars land in one place
const frame = 'M12 30V12H52V34 M12 36V52H33';
const lang = t.lang === 'en' ? 'en' : 'zh';
const canonical = t.lang === 'en' ? 'https://deskmind.dev/' : 'https://deskmind.dev/zh/';
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'DeskMind',
    alternateName: 'DeskMind 得心', description: t.description, url: canonical,
    applicationCategory: 'DeveloperApplication', operatingSystem: 'macOS 15 or later (Apple Silicon)',
    downloadUrl: APP_DOWNLOAD, license: 'https://www.apache.org/licenses/LICENSE-2.0',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    image: 'https://deskmind.dev/assets/og-1280x640.png', inLanguage: t.lang,
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: t.lang,
    mainEntity: t.faq.items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org', '@type': 'Organization', name: 'DeskMind', url: 'https://deskmind.dev/',
    logo: 'https://deskmind.dev/assets/avatar-1000.png',
    sameAs: ['https://github.com/deskmind-ai', 'https://huggingface.co/deskmind', 'https://modelscope.cn/models/gxcsoccer/brain-4b'],
  },
];
---
<!doctype html>
<html lang={t.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{t.title}</title>
<meta name="description" content={t.description}>
<link rel="icon" href="/assets/favicon.ico">
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="en" href="https://deskmind.dev/">
<link rel="alternate" hreflang="zh-CN" href="https://deskmind.dev/zh/">
<link rel="alternate" hreflang="x-default" href="https://deskmind.dev/">
<link rel="sitemap" href="/sitemap-index.xml">
<meta name="theme-color" content="#F4F1EA">
<meta property="og:type" content="website">
<meta property="og:site_name" content="DeskMind">
<meta property="og:url" content={canonical}>
<meta property="og:locale" content={t.lang === 'en' ? 'en_US' : 'zh_CN'}>
<meta property="og:locale:alternate" content={t.lang === 'en' ? 'zh_CN' : 'en_US'}>
<meta property="og:title" content={t.title}>
<meta property="og:description" content={t.description}>
<meta property="og:image" content="https://deskmind.dev/assets/og-1280x640.png">
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="640">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={t.title}>
<meta name="twitter:description" content={t.description}>
<meta name="twitter:image" content="https://deskmind.dev/assets/og-1280x640.png">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<script is:inline src="/t.js" defer></script>
<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "5e52e4679d4346d7989c697163f84f33"}'></script>
</head>
<body>

<header class="wrap top">
  <a href={t.lang === 'en' ? '/' : '/zh/'} aria-label={t.homeLabel} class="logo"><img src="/assets/bilingual-horizontal-light.svg" alt="DeskMind 得心" width="150" height="30"></a>
  <nav aria-label={t.navLabel} class="nav">
    <a href={t.docs}>{t.nav.docs}</a>
    <a href={t.post.href}>{t.post.footer}</a>
    <a href={HUB}>GitHub</a>
    <a href={t.other.href} hreflang={t.lang === 'en' ? 'zh-CN' : 'en'}>{t.other.label}</a>
    <a href={APP_DOWNLOAD} class="btn btn-dark btn-sm">{t.nav.download}</a>
  </nav>
</header>

<main>
<section id="top" class="wrap hero">
  <div class="stack">
    <a href={t.post.href} class="pill"><span class="dot" aria-hidden="true"></span>{t.post.pill}<span aria-hidden="true">→</span></a>
    <h1>{t.hero.title[0]}{t.lang !== 'en' && <br>}{t.hero.title[1]}<span class="accent">{t.lang === 'en' ? '.' : '。'}</span></h1>
    <p class="lead">{t.hero.lead}</p>
    <div class="row">
      <a href={APP_DOWNLOAD} class="btn btn-dark">{t.nav.download}</a>
      <a href={t.hero.githubHref} class="btn btn-line btn-star"><svg class="star" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>{t.hero.github}</a>
    </div>
    <div class="meta">{t.hero.meta}</div>
  </div>
  <figure class="demo">
    <div class="demo-frame" data-demo data-full={t.hero.video}>
      <video class="vloop" muted loop playsinline preload="none" width="1280" height="720"
        poster={`/video/hook-${lang}.jpg`} data-src={`/video/hook-${lang}.mp4`} aria-label={t.hero.posterAlt}></video>
      <button type="button" class="play" aria-label={t.hero.playLabel}>
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 7.2V14.8L15 11Z" fill="currentColor"/></svg>
        {t.hero.play}
      </button>
      <button type="button" class="pause" aria-label={t.hero.pauseLabel} aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path class="i-pause" d="M3 2h3v10H3zM8 2h3v10H8z" fill="currentColor"/><path class="i-play" d="M3 1.5v11L12 7z" fill="currentColor"/></svg>
      </button>
    </div>
    <figcaption>{t.hero.caption}</figcaption>
  </figure>
</section>

<section class="band">
  <div class="wrap section">
    <h2>{t.diff.title}</h2>
    <div class="grid cards3">
      {t.diff.cards.map((c, i) => (
        <div class="card">
          <div class="num">{String(i + 1).padStart(2, '0')}</div>
          <h3>{c.title}</h3>
          <p set:html={c.body} />
          <div class="proof">{c.proof}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="how" class="band soft">
  <div class="wrap section">
    <div class="intro">
      <h2>{t.how.title}</h2>
      <p class="sub">{t.how.lead}</p>
    </div>
    <div class="how">
      <div class="loop">
        <div class="chain">
          <a href={`${GH}/eyes`} class="part">
            <svg width="56" height="56" viewBox="0 0 64 64" aria-hidden="true"><path d={frame} class="fr"/><circle cx="46" cy="46" r="8" fill="none" class="ac-s" stroke-width="3"/><circle cx="46" cy="46" r="3.4" class="ac-f"/></svg>
            <span class="pname">Eyes</span><span class="pdesc">{t.how.eyes}</span>
          </a>
          <div class="link" aria-hidden="true"></div>
          <a href={`${GH}/brain`} class="part">
            <svg width="56" height="56" viewBox="0 0 64 64" aria-hidden="true"><path d={frame} class="fr"/><path d="M40.25 51.5A8 8 0 1 1 51.6 51.5" fill="none" class="ac-s" stroke-width="3.2" stroke-linecap="round"/><circle cx="46" cy="46" r="2.6" class="ac-f"/></svg>
            <span class="pname">Brain</span><span class="pdesc">{t.how.brain}</span>
          </a>
          <div class="link" aria-hidden="true"></div>
          <a href={`${GH}/hands`} class="part">
            <svg width="56" height="56" viewBox="0 0 64 64" aria-hidden="true"><path d={frame} class="fr"/><circle cx="46" cy="42.7" r="6.3" class="ac-f"/><path d="M37 52H55" class="ac-s" stroke-width="3.6" stroke-linecap="square"/></svg>
            <span class="pname">Hands</span><span class="pdesc">{t.how.hands}</span>
          </a>
        </div>
        <a href={`${GH}/deskmind/tree/main/app`} class="app">
          <svg width="40" height="40" viewBox="0 0 64 64" aria-hidden="true"><path d={frame} class="fr"/><rect x="39" y="39" width="14" height="14" rx="3" class="ac-f"/></svg>
          <span class="pname">App</span><span class="pdesc">{t.how.app}</span>
        </a>
      </div>
      <a href={`${GH}/bench`} class="bench part">
        <svg width="56" height="56" viewBox="0 0 64 64" aria-hidden="true"><path d={frame} class="fr"/><circle cx="46" cy="46" r="3.1" class="ac-f"/><path d="M39.6 43V49M52.4 43V49" fill="none" class="ac-s" stroke-width="3" stroke-linecap="square"/></svg>
        <span class="pname">Bench</span><span class="pdesc">{t.how.bench}</span>
      </a>
    </div>
  </div>
</section>

<section id="cases" class="wrap section">
  <div class="intro">
    <h2>{t.cases.title}</h2>
    <p class="sub">{t.cases.lead}</p>
  </div>
  <div class="grid cases">
    {t.cases.items.map((c) => (
      <article class="case">
        <div class="clip">
          <video class="vloop" muted loop playsinline preload="none" width="960" height="522" data-start={c.start}
            poster={`/video/case-${c.clip}-${lang}.jpg`} data-src={`/video/case-${c.clip}-${lang}.mp4`} aria-label={c.alt}></video>
          <span class="badge">{t.cases.badge}</span>
          <button type="button" class="watch" data-start={c.start}>{t.cases.watch}</button>
        </div>
        <div class="case-body">
          <h3>{c.title}</h3>
          <p class="goal">{c.goal}</p>
          <p>{c.note}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<section id="results" class="dark">
  <div class="wrap section">
    <div class="intro">
      <h2>{t.results.title}</h2>
      <p class="sub">{t.results.lead}</p>
    </div>
    <div class="grid stats">
      {t.results.stats.map(([n, d]) => (
        <div class="stat"><div class="big">{n}</div><div class="dim">{d}</div></div>
      ))}
    </div>
    <div class="grid notes">
      <div class="stack-s">
        <div class="strong">{t.results.hardTitle}</div>
        <ul class="dim">{t.results.hard.map((h) => <li>{h}</li>)}</ul>
      </div>
      <div class="stack-s">
        <div class="strong">{t.results.howTitle}</div>
        <p class="dim">{t.results.how}</p>
        <a href={`${GH}/bench`} class="under">{t.results.more}</a>
        <a href={t.post.href} class="under">{t.post.results}</a>
      </div>
    </div>
  </div>
</section>

<section id="faq" class="wrap section faqsec">
  <div class="intro">
    <h2>{t.faq.title}</h2>
  </div>
  <div class="faqlist">
    {t.faq.items.map(([q, a], i) => (
      <details open={i === 0}>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
  <a href={t.faq.href} class="more">{t.faq.more}</a>
</section>

<section id="download" class="band soft">
  <div class="wrap cta">
    <img src="/assets/xiaofang-done.svg" alt={t.cta.mascotAlt} width="120" height="120" class="mascot">
    <h2 class="cta-title">{t.cta.title}</h2>
    <p class="sub">{t.cta.lead}</p>
    <div class="row center">
      <a href={APP_DOWNLOAD} class="btn btn-dark">{t.cta.download}</a>
      <a href={HUB} class="btn btn-line btn-star"><svg class="star" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>{t.hero.github}</a>
    </div>
    <div class="meta">{t.cta.meta} · <a href={t.quickstart} class="under-dark">{t.cta.quickstart}</a> · <a href={APP_RELEASES} class="under-dark">{t.lang === 'en' ? 'Release notes' : '版本说明'}</a></div>
  </div>
</section>
</main>

<footer class="wrap foot">
  <div class="stack-s licence">
    <img src="/assets/bilingual-horizontal-light.svg" alt="DeskMind 得心" width="120" height="24">
    <span>{t.footer.licence}</span>
    <span class="fine">{t.footer.privacy}</span>
  </div>
  <nav aria-label={t.footerLabel} class="fnav">
    <a href={t.docs}>{t.footer.docs}</a>
    <a href={t.faq.href}>{t.footer.faq}</a>
    <a href={t.post.href}>{t.post.footer}</a>
    <a href={HUB}>GitHub</a>
    <a href="https://huggingface.co/deskmind">Hugging Face</a>
    <a href={`${GH}/deskmind/discussions`}>{t.footer.discussions}</a>
    <a href={`${GH}/.github/blob/main/SECURITY.md`}>{t.footer.security}</a>
    <a href={`${GH}/deskmind/blob/main/${t.lang === 'en' ? 'BRAND.md' : 'BRAND.zh-CN.md'}`}>{t.footer.brand}</a>
  </nav>
</footer>

<script>
  // Muted loops (hero hook, case clips) load only near the viewport and play only while visible; no autoplay with
  // reduced motion or Save-Data. The hero button switches to the full video with sound and controls.
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator as any).connection?.saveData === true;
  const loops = Array.from(document.querySelectorAll<HTMLVideoElement>('video.vloop'));
  const load = (v: HTMLVideoElement) => { if (!v.src && v.dataset.src) { v.src = v.dataset.src; } };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { if (!calm && v.dataset.paused !== '1') { load(v); v.play().catch(() => {}); } }
        else if (!v.paused) v.pause();
      }
    }, { rootMargin: '200px 0px', threshold: 0.25 });
    loops.forEach((v) => io.observe(v));
  }
  const frame = document.querySelector<HTMLElement>('[data-demo]');
  if (frame) {
    const hook = frame.querySelector<HTMLVideoElement>('video.vloop')!;
    const pause = frame.querySelector<HTMLButtonElement>('.pause')!;
    const sync = () => pause.setAttribute('aria-pressed', String(hook.paused));
    hook.addEventListener('play', sync); hook.addEventListener('pause', sync);
    pause.addEventListener('click', () => {
      load(hook);
      if (hook.paused) { hook.dataset.paused = ''; hook.play().catch(() => {}); } else { hook.dataset.paused = '1'; hook.pause(); }
    });
    const label = frame.querySelector<HTMLButtonElement>('.play')!.getAttribute('aria-label') || '';
    // Play the full video with sound in the hero, from `start` seconds (a case card jumps to its own segment).
    const playFull = (start: number) => {
      let v = frame.querySelector<HTMLVideoElement>('video.full');
      if (!v) {
        v = document.createElement('video');
        v.className = 'full'; v.src = frame.dataset.full!; v.controls = true; v.playsInline = true;
        v.width = 1280; v.height = 720; v.poster = hook.poster; v.setAttribute('aria-label', label);
        frame.replaceChildren(v);
      }
      const go = () => { v!.currentTime = start; v!.play().catch(() => {}); };
      if (v.readyState >= 1) go(); else v.addEventListener('loadedmetadata', go, { once: true });
      v.focus({ preventScroll: true });
    };
    frame.querySelector<HTMLButtonElement>('.play')!.addEventListener('click', () => playFull(0));
    for (const el of document.querySelectorAll<HTMLElement>('#cases [data-start]')) {
      el.addEventListener('click', () => {
        frame.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'center' });
        playFull(Number(el.dataset.start) || 0);
      });
    }
  }
</script>

<style is:global>
  :root {
    --paper: #F4F1EA; --paper-2: #FBFAF6; --ink: #262B28; --ink-2: #4A504C; --ink-3: #5C625E;
    --line: rgba(38, 43, 40, 0.12); --accent: #C95536;
    --sans: Manrope, 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Microsoft YaHei', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); line-height: 1.5; -webkit-font-smoothing: antialiased; }
  a { color: var(--ink); text-decoration: none; }
  a:hover { color: #000; }
  img, video { max-width: 100%; }
  code { font-family: var(--mono); font-size: 0.9em; }
  h1, h2, h3 { font-weight: 500; margin: 0; text-wrap: balance; }
  p { margin: 0; }
</style>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding-left: 40px; padding-right: 40px; }
  .section { padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 48px; }
  .band { border-top: 1px solid var(--line); }
  .soft { background: var(--paper-2); border-bottom: 1px solid var(--line); }
  .stack { display: flex; flex-direction: column; gap: 28px; }
  .stack-s { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .row { display: flex; gap: 12px; flex-wrap: wrap; }
  .center { justify-content: center; }
  .grid { display: grid; gap: 24px; }
  .intro { display: flex; flex-direction: column; gap: 14px; max-width: 720px; }
  h2 { font-size: 36px; letter-spacing: -0.01em; }
  .sub { font-size: 18px; color: var(--ink-2); }
  .meta { font-size: 13px; color: var(--ink-3); }
  .muted { color: var(--ink-2); }
  .strong { font-weight: 500; }
  .accent { color: var(--accent); }

  .top { padding-top: 28px; padding-bottom: 28px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .logo img { display: block; height: 30px; width: auto; }
  .nav { display: flex; align-items: center; gap: 28px; font-size: 15px; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 14px 24px; border-radius: 999px; font-weight: 500; font-size: 16px; }
  .btn-sm { padding: 10px 18px; font-size: 15px; }
  .btn-dark { background: var(--ink); color: var(--paper); }
  .btn-dark:hover { color: #fff; background: #000; }
  .btn-line { border: 1px solid var(--ink); padding: 13px 23px; }
  /* Stars are how people find the project on GitHub; the visible way to give one sits next to the download. */
  .btn-star { display: inline-flex; align-items: center; gap: 8px; }
  .btn-star .star { color: #e3b341; flex: none; }

  .hero { padding-top: 72px; padding-bottom: 96px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: center; }
  .eyebrow { font-size: 14px; letter-spacing: 0.02em; color: var(--ink-3); }
  .pill { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; padding: 6px 14px 6px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--paper-2); font-size: 14px; color: var(--ink-2); }
  .pill:hover { border-color: var(--accent); color: var(--ink); }
  .pill .dot { width: 8px; height: 8px; border-radius: 99px; background: var(--accent); }
  h1 { font-size: 60px; line-height: 1.08; letter-spacing: -0.02em; }
  :global(html[lang='zh-CN']) h1 { font-size: 46px; line-height: 1.25; letter-spacing: 0; }
  .lead { font-size: 19px; color: var(--ink-2); max-width: 520px; }
  .demo { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .demo-frame { position: relative; border-radius: 16px; overflow: hidden; background: var(--paper-2); box-shadow: 0 1px 2px rgba(38,43,40,0.06), 0 12px 32px rgba(38,43,40,0.08); }
  .demo-frame video, .demo-frame :global(video) { width: 100%; height: auto; aspect-ratio: 16 / 9; display: block; background: var(--paper-2); }
  .pause { position: absolute; right: 16px; bottom: 24px; width: 36px; height: 36px; display: grid; place-items: center; border: 0; border-radius: 999px; background: rgba(251,250,246,0.94); color: var(--ink); cursor: pointer; }
  .pause .i-play { display: none; }
  .pause[aria-pressed='true'] .i-play { display: inline; }
  .pause[aria-pressed='true'] .i-pause { display: none; }
  .play:focus-visible, .pause:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .play { position: absolute; left: 24px; bottom: 24px; display: flex; align-items: center; gap: 10px; padding: 10px 16px 10px 12px; border: 0; border-radius: 999px; background: rgba(251,250,246,0.94); font: inherit; font-size: 14px; font-weight: 500; color: var(--ink); cursor: pointer; }
  .play:hover { background: #fff; }
  figcaption { font-size: 13px; color: var(--ink-3); }

  .cards3 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .card { background: var(--paper-2); border-radius: 16px; padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .card h3 { font-size: 22px; }
  .card p { color: var(--ink-2); }
  .num { font-size: 13px; color: var(--ink-3); }
  .proof { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 13px; color: var(--ink-2); }

  .how { display: flex; gap: 32px; align-items: stretch; flex-wrap: wrap; }
  .loop { flex: 1 1 640px; border: 1px solid rgba(38,43,40,0.2); border-radius: 20px; padding: 36px 36px 28px; display: flex; flex-direction: column; gap: 32px; }
  .chain { display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .part { flex: 1 1 140px; display: flex; flex-direction: column; gap: 10px; }
  .link { flex: 0 0 40px; height: 1.5px; background: var(--ink); margin-top: 28px; }
