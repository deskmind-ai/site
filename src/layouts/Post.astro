---
// Blog post layout: the homepage's paper-and-ink look with a readable column. Used by src/pages/**/blog/*.md.
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/jetbrains-mono/400.css';
const { frontmatter } = Astro.props;
const zh = frontmatter.lang === 'zh-CN';
const canonical = new URL(Astro.url.pathname, 'https://deskmind.dev').href;
// The same post in the other language: /blog/x/ <-> /zh/blog/x/.
const path = Astro.url.pathname;
const enPath = zh ? path.replace(/^\/zh/, '') : path;
const zhPath = zh ? path : '/zh' + path;
const other = zh ? { href: enPath, label: 'English' } : { href: zhPath, label: '中文' };
---
<!doctype html>
<html lang={frontmatter.lang || 'en'}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{frontmatter.title} · DeskMind</title>
<meta name="description" content={frontmatter.description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="en" href={new URL(enPath, 'https://deskmind.dev').href}>
<link rel="alternate" hreflang="zh-CN" href={new URL(zhPath, 'https://deskmind.dev').href}>
<link rel="icon" href="/assets/favicon.ico">
<meta property="og:type" content="article">
<meta property="og:title" content={frontmatter.title}>
<meta property="og:description" content={frontmatter.description}>
<meta property="og:image" content="https://deskmind.dev/assets/og-1280x640.png">
<meta name="twitter:card" content="summary_large_image">
<script is:inline src="/t.js" defer></script>
</head>
<body>
<header class="top">
  <a href={zh ? '/zh/' : '/'} class="logo"><img src="/assets/bilingual-horizontal-light.svg" alt="DeskMind 得心" width="150" height="30"></a>
  <nav>
    <a href={zh ? '/zh/docs/' : '/docs/'}>{zh ? '文档' : 'Docs'}</a>
    <a href="https://github.com/deskmind-ai">GitHub</a>
    <a href={other.href} hreflang={zh ? 'en' : 'zh-CN'} lang={zh ? 'en' : 'zh-CN'}>{other.label}</a>
    <a href="https://github.com/deskmind-ai/app/releases/latest" class="dl">{zh ? '下载 Mac App' : 'Download for Mac'}</a>
  </nav>
</header>
<main class="post">
  <p class="date">{frontmatter.date}</p>
  <slot />
</main>
<footer class="foot">{zh ? '代码 Apache-2.0，文字 CC BY 4.0。' : 'Code Apache-2.0, text CC BY 4.0.'} <a href={zh ? '/zh/' : '/'}>deskmind.dev</a></footer>
<style is:global>
  :root { --paper: #F4F1EA; --paper-2: #FBFAF6; --ink: #262B28; --ink-2: #4A504C; --ink-3: #5C625E; --line: rgba(38,43,40,.12); --accent: #C95536; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: Manrope, 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', system-ui, sans-serif; line-height: 1.7; -webkit-font-smoothing: antialiased; }
  a { color: var(--ink); }
  .top { max-width: 1040px; margin: 0 auto; padding: 24px 20px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .top img { height: 28px; width: auto; display: block; }
  .top nav { display: flex; gap: 20px; align-items: center; font-size: 15px; }
  .top nav a { text-decoration: none; }
  .dl { background: var(--ink); color: var(--paper) !important; padding: 8px 16px; border-radius: 999px; }
  .post { max-width: 720px; margin: 0 auto; padding: 24px 20px 80px; font-size: 17px; }
  .post h1 { font-size: 40px; line-height: 1.2; font-weight: 500; letter-spacing: -0.01em; margin: 8px 0 24px; text-wrap: balance; }
  .post h2 { font-size: 24px; font-weight: 500; margin: 48px 0 12px; }
  .post p, .post li { color: var(--ink-2); }
  .post strong { color: var(--ink); font-weight: 500; }
  .post a { text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .post code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.88em; background: var(--paper-2); padding: 1px 5px; border-radius: 4px; }
  .post pre { background: var(--ink); color: var(--paper); padding: 16px 20px; border-radius: 12px; overflow-x: auto; font-size: 14px; line-height: 1.6; }
  .post pre code { background: none; padding: 0; color: inherit; }
  .post table { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
  .post th, .post td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .post th { font-weight: 500; color: var(--ink-3); font-size: 13px; }
  .post hr { border: 0; border-top: 1px solid var(--line); margin: 32px 0; }
  .date { color: var(--ink-3); font-size: 14px; margin: 0; }
  html[lang='zh-CN'] .post h1 { font-size: 34px; line-height: 1.35; letter-spacing: 0; }
  html[lang='zh-CN'] .post em { font-style: normal; color: var(--ink-3); }
  .nw { white-space: nowrap; }
  .fig { margin: 28px 0; }
  .fig img, .fig video { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); background: var(--paper-2); }
  .fig figcaption { font-size: 13px; color: var(--ink-3); margin-top: 8px; }
  .foot { max-width: 720px; margin: 0 auto; padding: 0 20px 48px; color: var(--ink-3); font-size: 13px; }
  @media (max-width: 640px) { .post h1, html[lang='zh-CN'] .post h1 { font-size: 28px; } .post { font-size: 16px; } }
</style>
</body>
</html>
